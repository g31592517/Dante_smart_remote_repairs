# ---------- runtime ----------
NODE_ENV=development
PORT=4000
# Public URL of the web app (used in e-mails and CORS)
APP_URL=http://localhost:5173
# Public URL of this API (used for payment-gateway return/callback URLs)
API_URL=http://localhost:4000
# Comma-separated list of browser origins allowed to call the API. MUST include every origin the web
# app is served from (the refresh-cookie session restore checks it), e.g. https://www.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
LOG_LEVEL=info
# Rate limits per client IP: auth = sign-in/registration/reset attempts per 15 min; api = requests per minute
AUTH_RATE_LIMIT=20
API_RATE_LIMIT=300

# ---------- database (MySQL 8) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dante
DB_PASSWORD=change-me
DB_NAME=dante_dev
DB_POOL_MAX=10

# ---------- authentication ----------
# 64+ random characters, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Set true behind HTTPS so the refresh cookie gets the Secure flag
COOKIE_SECURE=false

# ---------- file storage ----------
# Private directory for uploads (attachments, intake photos). Must NOT be web-served.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# ---------- e-mail ----------
# EMAIL_TRANSPORT=smtp | log   (log = write e-mails to the server log; for development)
EMAIL_TRANSPORT=log
EMAIL_FROM="Dante Smart Remote Repairs <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ---------- SMS / WhatsApp (optional extension points; leave blank = disabled) ----------
SMS_PROVIDER=
SMS_API_KEY=
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=

# ---------- AnyDesk REST API (optional; requires a licence with API access) ----------
# Leave blank to use the manual workflow (URL handler + technician-recorded sessions).
ANYDESK_API_URL=https://v1.api.anydesk.com:8081
ANYDESK_LICENSE_ID=
ANYDESK_API_PASSWORD=

# ---------- payments ----------
# PAYMENT_GATEWAY=none | stripe   (offline methods always work; see docs/06_INTEGRATIONS.md)
PAYMENT_GATEWAY=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Unpaid orders (other than pay-on-collection) are cancelled and their stock released after this many hours
ORDER_PAYMENT_TIMEOUT_HOURS=72
